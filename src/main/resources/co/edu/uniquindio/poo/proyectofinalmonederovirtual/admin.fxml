<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Para conectar el controlador, agrega en BorderPane:
  fx:controller="tu.paquete.AdminController"
-->

<BorderPane fx:id="rootAdmin" prefHeight="780.0" prefWidth="1280.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@monedero.css" />
      <URL value="@extras.css" />
   </stylesheets>

   <!-- ===================== BARRA LATERAL ===================== -->
   <left>
      <VBox fx:id="sidebarAdmin" prefWidth="250.0" spacing="8.0" styleClass="sidebar">
         <padding>
            <Insets bottom="24.0" left="18.0" right="18.0" top="28.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="logo-icon" text="💳" />
                  <Label fx:id="lblLogoAdmin" styleClass="logo-text" text="MiMonedero" />
               </children>
               <VBox.margin>
                  <Insets bottom="24.0" />
               </VBox.margin>
            </HBox>

            <!-- Perfil admin -->
            <VBox alignment="CENTER" spacing="6.0" styleClass="profile-box">
               <children>
                  <Label fx:id="lblInicialesAdmin" styleClass="avatar" text="AD" />
                  <Label fx:id="lblNombreAdmin" styleClass="profile-name" text="Administrador" />
                  <Label fx:id="lblCorreoAdmin" styleClass="profile-mail" text="admin@mimonedero.com" />
                  <Label fx:id="lblRolAdmin" styleClass="badge-admin" text="🛡 ADMIN" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </VBox>

            <!-- Navegación -->
            <Button fx:id="btnPanelGeneral" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button-active" text="📊  Panel general" />
            <Button fx:id="btnUsuarios" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="👥  Usuarios" />
            <Button fx:id="btnTransacciones" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="💸  Transacciones" />
            <Button fx:id="btnBeneficiosAdmin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="🎁  Beneficios  ▾" />

            <!-- Submenú de beneficios -->
            <VBox fx:id="subMenuBeneficiosAdmin" spacing="2.0" styleClass="sub-menu">
               <children>
                  <Button fx:id="btnCatalogoBeneficios" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sub-nav-button-active" text="•  Catálogo" />
                  <Button fx:id="btnCanjesPendientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sub-nav-button" text="•  Canjes pendientes" />
               </children>
            </VBox>

            <Button fx:id="btnReportes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="📈  Reportes" />
            <Button fx:id="btnConfiguracionAdmin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="⚙  Configuración" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnCerrarSesionAdmin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="logout-button" text="🚪  Cerrar sesión" />
         </children>
      </VBox>
   </left>

   <!-- ===================== CONTENIDO ===================== -->
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
         <content>
            <VBox spacing="22.0" styleClass="content-area">
               <padding>
                  <Insets bottom="30.0" left="32.0" right="32.0" top="28.0" />
               </padding>
               <children>

                  <!-- Encabezado -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label fx:id="lblTituloAdmin" styleClass="title" text="Panel de administración 🛡" />
                              <Label fx:id="lblSubtituloAdmin" styleClass="subtitle" text="Visión completa de usuarios, transacciones y beneficios" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnNotificacionesAdmin" mnemonicParsing="false" styleClass="icon-button" text="🔔" />
                        <Label fx:id="lblEstadoSistema" styleClass="badge-success" text="● Sistema operativo" />
                     </children>
                  </HBox>

                  <!-- Estadísticas -->
                  <HBox spacing="20.0">
                     <children>
                        <VBox maxWidth="1.7976931348623157E308" spacing="6.0" styleClass="stat-card-purple" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="stat-icon" text="👥" />
                              <Label styleClass="stat-caption" text="Usuarios registrados" />
                              <Label fx:id="lblTotalUsuarios" styleClass="stat-value" text="1.248" />
                           </children>
                        </VBox>
                        <VBox maxWidth="1.7976931348623157E308" spacing="6.0" styleClass="stat-card-income" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="stat-icon" text="💰" />
                              <Label styleClass="stat-caption" text="Saldo en circulación" />
                              <Label fx:id="lblSaldoCirculacion" styleClass="stat-value" text="\$ 85.430.000" />
                           </children>
                        </VBox>
                        <VBox maxWidth="1.7976931348623157E308" spacing="6.0" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="stat-icon" text="🔁" />
                              <Label styleClass="stat-caption" text="Transacciones de hoy" />
                              <Label fx:id="lblTransaccionesHoy" styleClass="stat-value" text="326" />
                           </children>
                        </VBox>
                        <VBox maxWidth="1.7976931348623157E308" spacing="6.0" styleClass="stat-card-expense" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="stat-icon" text="🎟" />
                              <Label styleClass="stat-caption" text="Canjes pendientes" />
                              <Label fx:id="lblCanjesPendientes" styleClass="stat-value" text="12" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- ============ USUARIOS ============ -->
                  <VBox fx:id="cardUsuarios" spacing="12.0" styleClass="card">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label styleClass="card-title" text="👥  Gestión de usuarios" />
                              <Region HBox.hgrow="ALWAYS" />
                              <TextField fx:id="txtBuscarUsuario" prefWidth="220.0" promptText="🔍 Buscar usuario..." styleClass="input" />
                              <ComboBox fx:id="cmbEstadoUsuario" prefWidth="150.0" promptText="Estado" styleClass="input-combo" />
                              <Button fx:id="btnNuevoUsuario" mnemonicParsing="false" styleClass="primary-button, small-button" text="➕ Nuevo usuario" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblUsuarios" prefHeight="240.0">
                           <columns>
                              <TableColumn fx:id="colUsuId" prefWidth="70.0" text="ID" />
                              <TableColumn fx:id="colUsuNombre" prefWidth="190.0" text="Nombre" />
                              <TableColumn fx:id="colUsuCorreo" prefWidth="220.0" text="Correo" />
                              <TableColumn fx:id="colUsuRol" prefWidth="110.0" text="Rol" />
                              <TableColumn fx:id="colUsuSaldo" prefWidth="140.0" text="Saldo" />
                              <TableColumn fx:id="colUsuEstado" prefWidth="110.0" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnVerDetalleUsuario" mnemonicParsing="false" styleClass="ghost-button, small-button" text="👁 Ver detalle" />
                              <Button fx:id="btnEditarUsuario" mnemonicParsing="false" styleClass="ghost-button, small-button" text="✏ Editar" />
                              <Button fx:id="btnBloquearUsuario" mnemonicParsing="false" styleClass="warning-button, small-button" text="⛔ Bloquear" />
                              <Button fx:id="btnEliminarUsuario" mnemonicParsing="false" styleClass="danger-button, small-button" text="🗑 Eliminar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ============ TRANSACCIONES ============ -->
                  <VBox fx:id="cardTransacciones" spacing="12.0" styleClass="card">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label styleClass="card-title" text="💸  Todas las transacciones" />
                              <Region HBox.hgrow="ALWAYS" />
                              <TextField fx:id="txtBuscarTransaccion" prefWidth="200.0" promptText="🔍 Buscar..." styleClass="input" />
                              <ComboBox fx:id="cmbTipoTransaccion" prefWidth="140.0" promptText="Tipo" styleClass="input-combo" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblTransacciones" prefHeight="260.0">
                           <columns>
                              <TableColumn fx:id="colTrxId" prefWidth="80.0" text="ID" />
                              <TableColumn fx:id="colTrxFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colTrxOrigen" prefWidth="160.0" text="Origen" />
                              <TableColumn fx:id="colTrxDestino" prefWidth="160.0" text="Destino" />
                              <TableColumn fx:id="colTrxTipo" prefWidth="110.0" text="Tipo" />
                              <TableColumn fx:id="colTrxMonto" prefWidth="130.0" text="Monto" />
                              <TableColumn fx:id="colTrxEstado" prefWidth="110.0" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnVerDetalleTransaccion" mnemonicParsing="false" styleClass="ghost-button, small-button" text="👁 Ver detalle" />
                              <Button fx:id="btnReversarTransaccion" mnemonicParsing="false" styleClass="warning-button, small-button" text="↩ Reversar" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnExportarTransacciones" mnemonicParsing="false" styleClass="success-button, small-button" text="📥 Exportar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ============ BENEFICIOS (CATÁLOGO) ============ -->
                  <VBox fx:id="cardBeneficiosAdmin" spacing="12.0" styleClass="card">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label styleClass="card-title" text="🎁  Catálogo de beneficios" />
                              <Region HBox.hgrow="ALWAYS" />
                              <TextField fx:id="txtBuscarBeneficioAdmin" prefWidth="220.0" promptText="🔍 Buscar beneficio..." styleClass="input" />
                              <Button fx:id="btnNuevoBeneficio" mnemonicParsing="false" styleClass="primary-button, small-button" text="➕ Nuevo beneficio" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblBeneficiosAdmin" prefHeight="220.0">
                           <columns>
                              <TableColumn fx:id="colBenId" prefWidth="70.0" text="ID" />
                              <TableColumn fx:id="colBenNombre" prefWidth="240.0" text="Beneficio" />
                              <TableColumn fx:id="colBenCategoria" prefWidth="140.0" text="Categoría" />
                              <TableColumn fx:id="colBenPuntos" prefWidth="110.0" text="Puntos" />
                              <TableColumn fx:id="colBenStock" prefWidth="100.0" text="Stock" />
                              <TableColumn fx:id="colBenEstado" prefWidth="110.0" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnEditarBeneficio" mnemonicParsing="false" styleClass="ghost-button, small-button" text="✏ Editar" />
                              <Button fx:id="btnActivarBeneficio" mnemonicParsing="false" styleClass="success-button, small-button" text="✔ Activar / Desactivar" />
                              <Button fx:id="btnEliminarBeneficio" mnemonicParsing="false" styleClass="danger-button, small-button" text="🗑 Eliminar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ============ CANJES ============ -->
                  <VBox fx:id="cardCanjesAdmin" spacing="12.0" styleClass="card">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <Label styleClass="card-title" text="🎟  Canjes de usuarios" />
                              <Region HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="cmbEstadoCanje" prefWidth="160.0" promptText="Estado del canje" styleClass="input-combo" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblCanjesAdmin" prefHeight="220.0">
                           <columns>
                              <TableColumn fx:id="colCanId" prefWidth="70.0" text="ID" />
                              <TableColumn fx:id="colCanUsuario" prefWidth="180.0" text="Usuario" />
                              <TableColumn fx:id="colCanBeneficio" prefWidth="220.0" text="Beneficio" />
                              <TableColumn fx:id="colCanPuntos" prefWidth="100.0" text="Puntos" />
                              <TableColumn fx:id="colCanFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colCanEstado" prefWidth="110.0" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Button fx:id="btnAprobarCanje" mnemonicParsing="false" styleClass="success-button, small-button" text="✔ Aprobar" />
                              <Button fx:id="btnRechazarCanje" mnemonicParsing="false" styleClass="danger-button, small-button" text="✖ Rechazar" />
                              <Label fx:id="lblMensajeAdmin" styleClass="message" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
