<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Para conectar el controlador, agrega en BorderPane:
  fx:controller="tu.paquete.BeneficiosController"
-->

<BorderPane fx:id="rootBeneficios" prefHeight="780.0" prefWidth="1200.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@monedero.css" />
      <URL value="@extras.css" />
   </stylesheets>

   <!-- ===================== BARRA LATERAL ===================== -->
   <left>
      <VBox fx:id="sidebar" prefWidth="240.0" spacing="8.0" styleClass="sidebar">
         <padding>
            <Insets bottom="24.0" left="18.0" right="18.0" top="28.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="logo-icon" text="💳" />
                  <Label fx:id="lblLogo" styleClass="logo-text" text="MiMonedero" />
               </children>
               <VBox.margin>
                  <Insets bottom="24.0" />
               </VBox.margin>
            </HBox>

            <VBox alignment="CENTER" spacing="6.0" styleClass="profile-box">
               <children>
                  <Label fx:id="lblIniciales" styleClass="avatar" text="DZ" />
                  <Label fx:id="lblUsuario" styleClass="profile-name" text="Usuario" />
                  <Label fx:id="lblCorreo" styleClass="profile-mail" text="correo@ejemplo.com" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </VBox>

            <Button fx:id="btnInicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="🏠  Inicio" />
            <Button fx:id="btnEnviar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="💸  Enviar dinero" />
            <Button fx:id="btnRecargar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="➕  Recargar saldo" />
            <Button fx:id="btnHistorial" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button" text="📜  Historial" />
            <Button fx:id="btnBeneficios" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="nav-button-active" text="🎁  Beneficios  ▾" />

            <!-- Submenú de beneficios -->
            <VBox fx:id="subMenuBeneficios" spacing="2.0" styleClass="sub-menu">
               <children>
                  <Button fx:id="btnCatalogo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sub-nav-button-active" text="•  Catálogo" />
                  <Button fx:id="btnMisCanjes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sub-nav-button" text="•  Mis canjes" />
                  <Button fx:id="btnMisPuntos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sub-nav-button" text="•  Mis puntos" />
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="logout-button" text="🚪  Cerrar sesión" />
         </children>
      </VBox>
   </left>

   <!-- ===================== CONTENIDO ===================== -->
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
         <content>
            <VBox spacing="22.0" styleClass="content-area">
               <padding>
                  <Insets bottom="30.0" left="32.0" right="32.0" top="28.0" />
               </padding>
               <children>

                  <!-- Encabezado -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label fx:id="lblTituloBeneficios" styleClass="title" text="Beneficios 🎁" />
                              <Label fx:id="lblSubtituloBeneficios" styleClass="subtitle" text="Canjea tus puntos por premios y descuentos" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtBuscarBeneficio" prefWidth="240.0" promptText="🔍 Buscar beneficio..." styleClass="input" />
                        <Button fx:id="btnNotificaciones" mnemonicParsing="false" styleClass="icon-button" text="🔔" />
                     </children>
                  </HBox>

                  <!-- Puntos y nivel -->
                  <HBox spacing="20.0">
                     <children>
                        <VBox prefWidth="520.0" spacing="10.0" styleClass="balance-card" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="balance-caption" text="Tus puntos disponibles" />
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <Label fx:id="lblPuntos" styleClass="balance-amount" text="⭐ 2.450" />
                                    <Label fx:id="lblNivel" styleClass="level-badge" text="🥇 Nivel Oro" />
                                 </children>
                              </HBox>
                              <ProgressBar fx:id="pbNivel" maxWidth="1.7976931348623157E308" progress="0.75" styleClass="level-progress" />
                              <Label fx:id="lblProgresoNivel" styleClass="balance-account" text="550 puntos para llegar a Platino" />
                           </children>
                        </VBox>

                        <VBox prefWidth="190.0" spacing="6.0" styleClass="stat-card-income">
                           <children>
                              <Label styleClass="stat-icon" text="🎟" />
                              <Label styleClass="stat-caption" text="Canjes realizados" />
                              <Label fx:id="lblCanjesRealizados" styleClass="stat-value" text="8" />
                           </children>
                        </VBox>

                        <VBox prefWidth="190.0" spacing="6.0" styleClass="stat-card-expense">
                           <children>
                              <Label styleClass="stat-icon" text="🔥" />
                              <Label styleClass="stat-caption" text="Puntos ganados este mes" />
                              <Label fx:id="lblPuntosMes" styleClass="stat-value" text="+320" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Panel de confirmación de canje (oculto por defecto) -->
                  <HBox fx:id="panelConfirmarCanje" alignment="CENTER_LEFT" managed="false" spacing="14.0" styleClass="confirm-panel" visible="false">
                     <children>
                        <Label fx:id="lblConfirmarTexto" styleClass="confirm-text" text="¿Deseas canjear este beneficio?" HBox.hgrow="ALWAYS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnConfirmarCanje" mnemonicParsing="false" styleClass="success-button, small-button" text="✔ Confirmar" />
                        <Button fx:id="btnCancelarCanje" mnemonicParsing="false" styleClass="ghost-button, small-button" text="Cancelar" />
                     </children>
                  </HBox>
                  <Label fx:id="lblMensajeCanje" styleClass="message" />

                  <!-- Filtros por categoría -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Button fx:id="btnCatTodos" mnemonicParsing="false" styleClass="chip-button-active" text="Todos" />
                        <Button fx:id="btnCatDescuentos" mnemonicParsing="false" styleClass="chip-button" text="🏷 Descuentos" />
                        <Button fx:id="btnCatRecargas" mnemonicParsing="false" styleClass="chip-button" text="📱 Recargas" />
                        <Button fx:id="btnCatEntretenimiento" mnemonicParsing="false" styleClass="chip-button" text="🎬 Entretenimiento" />
                        <Button fx:id="btnCatViajes" mnemonicParsing="false" styleClass="chip-button" text="✈ Viajes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbOrdenar" prefWidth="170.0" promptText="Ordenar por" styleClass="input-combo" />
                     </children>
                  </HBox>

                  <!-- Catálogo de beneficios -->
                  <FlowPane fx:id="fpBeneficios" hgap="18.0" vgap="18.0">
                     <children>

                        <!-- Beneficio 1 -->
                        <VBox fx:id="cardBeneficio1" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio1" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-purple" text="🎬" />
                              <Label fx:id="lblTituloBeneficio1" styleClass="benefit-title" text="20% en Cine" />
                              <Label fx:id="lblDescBeneficio1" styleClass="benefit-desc" text="Descuento en entradas para cualquier función." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio1" styleClass="benefit-cost" text="⭐ 500 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio1" styleClass="benefit-stock" text="Quedan 24" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear1" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>

                        <!-- Beneficio 2 -->
                        <VBox fx:id="cardBeneficio2" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio2" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-blue" text="📱" />
                              <Label fx:id="lblTituloBeneficio2" styleClass="benefit-title" text="Recarga gratis" />
                              <Label fx:id="lblDescBeneficio2" styleClass="benefit-desc" text="Recarga de celular de 10.000 pesos sin costo." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio2" styleClass="benefit-cost" text="⭐ 800 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio2" styleClass="benefit-stock" text="Quedan 50" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear2" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>

                        <!-- Beneficio 3 -->
                        <VBox fx:id="cardBeneficio3" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio3" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-green" text="☕" />
                              <Label fx:id="lblTituloBeneficio3" styleClass="benefit-title" text="Café 2x1" />
                              <Label fx:id="lblDescBeneficio3" styleClass="benefit-desc" text="Lleva dos cafés y paga solo uno en locales aliados." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio3" styleClass="benefit-cost" text="⭐ 300 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio3" styleClass="benefit-stock" text="Quedan 100" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear3" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>

                        <!-- Beneficio 4 -->
                        <VBox fx:id="cardBeneficio4" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio4" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-orange" text="✈" />
                              <Label fx:id="lblTituloBeneficio4" styleClass="benefit-title" text="Descuento en viajes" />
                              <Label fx:id="lblDescBeneficio4" styleClass="benefit-desc" text="15% de descuento en tiquetes nacionales." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio4" styleClass="benefit-cost" text="⭐ 2.000 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio4" styleClass="benefit-stock" text="Quedan 10" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear4" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>

                        <!-- Beneficio 5 -->
                        <VBox fx:id="cardBeneficio5" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio5" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-purple" text="📺" />
                              <Label fx:id="lblTituloBeneficio5" styleClass="benefit-title" text="Streaming 1 mes" />
                              <Label fx:id="lblDescBeneficio5" styleClass="benefit-desc" text="Un mes de suscripción a una plataforma de streaming." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio5" styleClass="benefit-cost" text="⭐ 1.500 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio5" styleClass="benefit-stock" text="Quedan 15" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear5" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>

                        <!-- Beneficio 6 -->
                        <VBox fx:id="cardBeneficio6" prefWidth="250.0" spacing="8.0" styleClass="benefit-card">
                           <children>
                              <Label fx:id="lblIconoBeneficio6" maxWidth="1.7976931348623157E308" styleClass="benefit-icon-green" text="💰" />
                              <Label fx:id="lblTituloBeneficio6" styleClass="benefit-title" text="Cashback" />
                              <Label fx:id="lblDescBeneficio6" styleClass="benefit-desc" text="Recibe 5.000 pesos directamente en tu saldo." wrapText="true" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label fx:id="lblCostoBeneficio6" styleClass="benefit-cost" text="⭐ 1.000 pts" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblStockBeneficio6" styleClass="benefit-stock" text="Quedan 30" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnCanjear6" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="primary-button" text="Canjear" />
                           </children>
                        </VBox>
                     </children>
                  </FlowPane>

                  <!-- Mis canjes -->
                  <VBox fx:id="cardMisCanjes" spacing="12.0" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="🎟  Mis canjes" />
                        <TableView fx:id="tblMisCanjes" prefHeight="230.0">
                           <columns>
                              <TableColumn fx:id="colMiCanjeFecha" prefWidth="140.0" text="Fecha" />
                              <TableColumn fx:id="colMiCanjeBeneficio" prefWidth="240.0" text="Beneficio" />
                              <TableColumn fx:id="colMiCanjePuntos" prefWidth="110.0" text="Puntos" />
                              <TableColumn fx:id="colMiCanjeCodigo" prefWidth="150.0" text="Código" />
                              <TableColumn fx:id="colMiCanjeEstado" prefWidth="120.0" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
